</svg>
</div></div><img src="https://cdn.prod.website-files.com/619776e2e737e7a8e46f94af/6a071e2d2ba615c4ca3e3970_Screenshot%202026-05-12%20at%2010.39.48.png" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/619776e2e737e7a8e46f94af/6a071e2d2ba615c4ca3e3970_Screenshot%202026-05-12%20at%2010.39.48-p-500.png 500w, https://cdn.prod.website-files.com/619776e2e737e7a8e46f94af/6a071e2d2ba615c4ca3e3970_Screenshot%202026-05-12%20at%2010.39.48-p-800.png 800w, https://cdn.prod.website-files.com/619776e2e737e7a8e46f94af/6a071e2d2ba615c4ca3e3970_Screenshot%202026-05-12%20at%2010.39.48-p-1080.png 1080w, https://cdn.prod.website-files.com/619776e2e737e7a8e46f94af/6a071e2d2ba615c4ca3e3970_Screenshot%202026-05-12%20at%2010.39.48.png 1478w" class="image-188"/><div class="div-block-272"><div class="text-color-white">Member Highlight<br/></div><div class="text-style-display text-color-white text-size-large">Esa-Pekka Salonen</div></div></a></div></div></div></div><div class="section-wom-concierge background-color-grey"><div class="padding-global"><div class="container-large"><div class="padding-section-medium"><h2 class="text-style-display">Meet WoM Concierge, your food-loving friend in every city of the world</h2><div class="text-align-left"><div class="spacer-large"></div><div class="chat-wrapper w-embed w-script"><!-- World of Mouth — Animated Concierge Chat Demo -->
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .chat-wrapper {
    width: 100%;
    height: 400px;
    position: relative;
    background: #ffffff;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    overflow: hidden;   
    box-shadow: 0px 2px 20px rgba(0, 0, 0, 0.12);
  }  
  .chat-shell {
    width: 100%;
    max-width: 800px;
    height: 400px;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;   
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #1a1a1a;
  }
  .chat-messages {
    padding: 24px 20px 16px;
    display: flex;
    flex: 1 1 auto;
    overflow-y: auto;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 80px;
  }
  .msg-user {
    align-self: flex-end;
    background: #0239D0;
    color: #ffffff;
    border-radius: 10px;
    padding: 10px 16px;
    max-width: 80%;
    font-size: 15px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .msg-user.visible { opacity: 1; transform: translateY(0); }
  .msg-concierge {
    align-self: flex-start;
    max-width: 100%;
    font-size: 16px;
    color: #1a1a1a;
  }
  .msg-concierge a {
    color: #0239D0;
    text-decoration: none;
    font-weight: 500;
  }
  .msg-concierge a:hover { text-decoration: underline; }
  .bistro-block {
    margin: 14px 0 0;
  }
  .bistro-name {
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 6px;
    color: #0239D0;
  }
  .bistro-desc {
    color: #444;
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 10px;
  }
  .bistro-quote {
    font-style: italic;
    color: #555;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 6px;
  }
  .bistro-attr {
    font-size: 14px;
  }
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: #1a1a1a;
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: blink 0.7s step-end infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .chat-bar-wrap {
    padding: 12px 16px 16px;
    flex: 0 0 auto;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0) 50%,
      rgba(255, 255, 255, 1) 50%,
      rgba(255, 255, 255, 1) 100%
    );
    position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
  }
  
  .chat-bar-standalone {
  position: static;
  background: none;
  padding: 0;
}
  
  .wom-bar {
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 24px;
    padding: 0 40px 0 20px;
    box-sizing: border-box;
    transition: border-color 0.15s;
    box-shadow: 0px 2px 20px rgba(0, 0, 0, 0.12);
  }
  .wom-bar:focus-within { border-color: #0239D0; }
  .wom-textarea {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: inherit;
    resize: none;
    min-height: 48px;
    max-height: 200px;
    overflow-y: auto;
    display: block;
    padding: 12px 12px 12px 0;
    margin: 0;
  }
  .wom-textarea::placeholder { color: #9ca3af; }
  .wom-send {
    position: absolute;
    right: 12px;
    bottom: 10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
    padding: 0;
    background: #9EAFD3;
  }
  .wom-send.active { background: #0239D0; }
  .wom-send svg { width: 14px; height: 14px; display: block; }
</style>

<div class="chat-wrapper">
  <div class="chat-shell">
  <div class="chat-messages">
    <div class="msg-user" id="womUserMsg">What are the best bistros in Paris?</div>
    <div class="msg-concierge" id="womConciergeMsg"></div>
  </div>
  <div class="chat-bar-wrap">
    <div class="wom-bar">
      <textarea class="wom-textarea" id="womDemoInput" rows="1" placeholder="Ask anything" aria-label="Ask the Concierge"></textarea>
      <button class="wom-send" id="womDemoSend" aria-label="Send" disabled>
        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 12V2M7 2L2.5 6.5M7 2L11.5 6.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div> 
  </div>
</div>

<script>
(function () {
  window.initWoMChatBar = function (inputId, sendId) {
    var input = document.getElementById(inputId);
    var send = document.getElementById(sendId);

    var placeholders = ['Ask anything','Best bistros in Paris','Pizza in New York','Hidden gems in Tokyo','Wine bars in Copenhagen','Brunch spots in London'];
    var phIndex = 0;
    var phTimer = setInterval(function() {
      phIndex = (phIndex + 1) % placeholders.length;
      input.placeholder = placeholders[phIndex];
    }, 5000);

    input.addEventListener('focus', function() { clearInterval(phTimer); input.placeholder = 'Ask anything'; });
    input.addEventListener('blur', function() {
      if (!input.value.trim()) phTimer = setInterval(function() {
        phIndex = (phIndex + 1) % placeholders.length;
        input.placeholder = placeholders[phIndex];
      }, 5000);
    });

    input.addEventListener('input', function() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 200) + 'px';
      var has = input.value.trim().length > 0;
      send.disabled = !has;
      send.classList.toggle('active', has);
    });

    function submit() {
      var q = input.value.trim();
      if (!q) return;
      window.open('https://portal.worldofmouth.app/try-concierge?q=' + encodeURIComponent(q).replace(/%20/g, '+'), '_blank');
    }

    send.addEventListener('click', submit);
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        submit();
      }
    });
  }

  window.initWoMChatBar('womDemoInput', 'womDemoSend');

  var bistros = [
    {
      name: 'Bistrot Paul Bert',
      desc: 'The one you go to if you only have time for one. Rue Paul Bert in the 11th, changing menu, proper classics: steak tartare, perfect frites, cheese passed from table to table. Old meat hooks in the ceiling from when it was a butcher shop. Next door: L\'Ecailler du Bistrot for seafood, La Cave for wine.',
      quote: '"I have eaten at Paul Bert 7 times this year and on each visit this little bistro overdelivers."',
      attr: 'James Hird\nSommelier \u00b7 WoM Expert'
    },
    {
      name: 'Le Baratin',
      desc: 'Belleville, Argentine chef Raquel Carena, open since the 80s natural wine bistro era. The calf\'s brain with potatoes and lemon butter is a legend. Service is blunt, wine list is exceptional, and the room feels like genuine Paris. Eight expert recommendations.',
      quote: '"If I had to choose one place to eat in Paris this would always be my choice. Raquel\'s cooking and the wine selection stands above the rest. When you sit at a table here you\'re a part of restaurant history."',
      attr: 'Gareth Storey\nChef \u00b7 WoM Expert'
    },
    {
      name: 'L\'Ami Jean',
      desc: 'Basque-inflected bistro in the 7th by chef St\u00e9phane Jego. Tightly packed, noisy, full of energy. \u00c0 la carte or put yourself in the chef\'s hands. The rice pudding served family-style in a big wooden bowl is the dish people mention for years afterwards.',
      quote: '"A big bowl of mashed potatoes from L\'Ami Jean followed by St\u00e9phane Jego\'s rice pudding. Neither of those was a favorite before living in Paris. But I think of both of these more regularly than I care to admit."',
      attr: 'Lindsey Tramuta\nWriter \u00b7 WoM Expert'
    },
    {
      name: 'Bistrot des Tournelles',
      desc: 'Marais, opened 2022, already feels like it\'s been there forever. Foie gras terrine, eggs mayo with black truffle, grilled andouillette, steak au poivre, tarte tatin. A marble walk-in bar counter. Natural wine list heavy on Beaujolais and Burgundy. Loud, candlelit, elbow-to-elbow.',
      quote: '"No visit to Paris is complete without a meal at Bistrot des Tournelles."',
      attr: 'Marti Buckley\nJournalist, author, cook \u00b7 WoM Expert'
    },
    {
      name: 'Parcelles',
      desc: 'Small street in the Marais, modern French with a wine-first mentality. Rajat Parr goes every Paris trip. Pascaline Lepeltier calls it \u201ca tribute to wines.\u201d Lunch is particularly good for the light. Thirteen expert recommendations.',
      quote: '"I love going to Parcelles. Modern French cooking, great atmosphere, great wine, very friendly service. I go there as often as I can when I go to Paris."',
      attr: 'Rajat Parr\nWinemaker, sommelier \u00b7 WoM Expert'
    },
    {
      name: 'Le Bon Georges',
      desc: '9th arrondissement, daily-changing menu, deep wine list with cult bottles. The hot oysters with Champagne sabayon and the aged entr\u00e9c\u00f4te with b\u00e9arnaise are regulars. A neighbourhood room that doesn\'t feel like it\'s trying too hard.',
      quote: '',
      attr: ''
    }
  ];

  var introText = 'Paris has serious bistro depth. Here are the strongest picks:';
  var closerText = 'Any of these match what you\'re after, or do you want something more specific\u2014date night, lunch, a particular arrondissement?';
  var container = document.getElementById('womConciergeMsg');
  var userMsg = document.getElementById('womUserMsg');
  var state = { phase: 'idle', introIdx: 0, bistroIdx: 0, bistroPhase: 'build', charIdx: 0, closerIdx: 0 };
  var introEl, cursorEl, bistroEls = [];

  function createCursor() { var c = document.createElement('span'); c.className = 'cursor'; return c; }

  function tick() {
    var delay = 18;
    if (state.phase === 'intro') {
      if (!introEl) {
        introEl = document.createElement('div');
        introEl.style.marginBottom = '4px';
        cursorEl = createCursor();
        introEl.appendChild(cursorEl);
        container.appendChild(introEl);
      }
      if (state.introIdx < introText.length) {
        introEl.insertBefore(document.createTextNode(introText[state.introIdx]), cursorEl);
        state.introIdx++;
        delay = 8;
      } else {
        introEl.removeChild(cursorEl); cursorEl = null;
        state.phase = 'bistros'; state.bistroIdx = 0; state.bistroPhase = 'build'; delay = 400;
      }

    } else if (state.phase === 'bistros') {
      var b = bistros[state.bistroIdx];

      if (state.bistroPhase === 'build') {
        var block = document.createElement('div'); block.className = 'bistro-block';
        var nameEl = document.createElement('div'); nameEl.className = 'bistro-name';
        nameEl.textContent = '';
        block.appendChild(nameEl);
        var descEl = document.createElement('div'); descEl.className = 'bistro-desc'; block.appendChild(descEl);
        if (b.quote) { var quoteEl = document.createElement('div'); quoteEl.className = 'bistro-quote'; block.appendChild(quoteEl); } else { quoteEl = null; }
        if (b.attr) { var attrEl = document.createElement('div'); attrEl.className = 'bistro-attr'; block.appendChild(attrEl); } else { attrEl = null; }
        container.appendChild(block);
        bistroEls[state.bistroIdx] = { name: nameEl, desc: descEl, quote: quoteEl, attr: attrEl };
        state.bistroPhase = 'name'; state.charIdx = 0; delay = 20;

      } else if (state.bistroPhase === 'name') {
        var els = bistroEls[state.bistroIdx];
        if (state.charIdx < b.name.length) { els.name.textContent += b.name[state.charIdx]; state.charIdx++; delay = 15; }
        else { state.bistroPhase = 'desc'; state.charIdx = 0; delay = 20; }

      } else if (state.bistroPhase === 'desc') {
        var els = bistroEls[state.bistroIdx];
        if (state.charIdx < b.desc.length) { els.desc.textContent += b.desc[state.charIdx]; state.charIdx++; delay = 4; }
        else { state.bistroPhase = b.quote ? 'quote' : (b.attr ? 'attr' : 'next'); state.charIdx = 0; delay = 20; }

      } else if (state.bistroPhase === 'quote') {
        var els = bistroEls[state.bistroIdx];
        if (state.charIdx < b.quote.length) { els.quote.textContent += b.quote[state.charIdx]; state.charIdx++; delay = 5; }
        else { state.bistroPhase = b.attr ? 'attr' : 'next'; state.charIdx = 0; delay = 20; }

      } else if (state.bistroPhase === 'attr') {
        var els = bistroEls[state.bistroIdx];
        if (state.charIdx < b.attr.length) { els.attr.textContent += b.attr[state.charIdx]; state.charIdx++; delay = 5; }
        else { state.bistroPhase = 'next'; delay = 20; }

      } else if (state.bistroPhase === 'next') {
        state.bistroIdx++;
        if (state.bistroIdx < bistros.length) { state.bistroPhase = 'build'; state.charIdx = 0; delay = 100; }
        else { state.phase = 'closer'; state.closerIdx = 0; delay = 120; }
      }

    } else if (state.phase === 'closer') {
      if (state.closerIdx === 0) {
        var el = document.createElement('div'); el.className = 'closer-line'; el.id = 'womCloserLine';
        cursorEl = createCursor(); el.appendChild(cursorEl); container.appendChild(el);
      }
      var closerLine = document.getElementById('womCloserLine');
      if (state.closerIdx < closerText.length) {
        closerLine.insertBefore(document.createTextNode(closerText[state.closerIdx]), cursorEl);
        state.closerIdx++; delay = 18;
      } else { closerLine.removeChild(cursorEl); state.phase = 'done'; return; }
    }

    setTimeout(tick, delay);
  }

  setTimeout(function() { userMsg.classList.add('visible'); }, 300);
  setTimeout(function() { state.phase = 'intro'; tick(); }, 1000);
})();
</script>
<!-- End World of Mouth Chat Demo --></div><div class="spacer-large"></div><div class="div-block-262"><div class="div-block-260"><a href="https://portal.worldofmouth.app/try-concierge" target="_blank" class="button-wom-header w-button">Try Concierge</a><div><div class="button-wom-header is-secondary w-embed"><a href="#" target="_blank" class="website-button" id="openModalButton">
  <aside class="openGetTheAppModal">
    <div class="text-color-black">Get the App</div>
  </aside>
</a></div></div></div></div></div></div></div></div></div><div class="section_faq"><div class="padding-global"><div class="container-large"><div class="padding-section-medium"><div class="cloneable-container-default"><h2 class="text-style-display text-align-center">Frequently Asked Questions<br/></h2><div class="spacer-large"></div><div data-w-id="65904593-024a-cf6a-a35d-cb3e8dbeb690" class="accordion-item---brix accordion-1---brix"><div class="accordion-trigger---brix"><div class="accordion-item-title---brix">What is World of Mouth?</div><div class="accordion-arrow-wrap---brix"><div style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0)" class="accordion-arrow-wrapper---brix"><div class="arrow-line---brix _2---brix"></div><div class="arrow-line---brix _1---brix"></div></div></div></div><div style="height:0px;opacity:0" class="accordion-content---brix"><p class="accordion-paragraph---brix">World of Mouth is a global community of restaurant lovers – like having a food-loving friend in every city in the world. It brings together chefs, restaurateurs, sommeliers, food writers and genuine food lovers, all sharing places they would recommend to their best friends.</p></div></div><div data-w-id="65904593-024a-cf6a-a35d-cb3e8dbeb69b" class="accordion-item---brix accordion-1---brix"><div class="accordion-trigger---brix"><div class="accordion-item-title---brix">How is World of Mouth different from other restaurant guides?</div><div class="accordion-arrow-wrap---brix"><div style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0)" class="accordion-arrow-wrapper---brix"><div class="arrow-line---brix _2---brix"></div><div class="arrow-line---brix _1---brix"></div></div></div></div><div style="height:0px;opacity:0" class="accordion-content---brix"><p class="accordion-paragraph---brix">Most platforms are built on anonymous ratings, stars, negativity and paid visibility. World of Mouth is different. There are no stars, no sponsored listings, and no &#x27;4.3 out of 5&#x27; averages. Every recommendation comes from genuine restaurant lovers who stand behind what they share. The idea is simple: we include only places you would recommend to your food-loving friends.</p></div></div><div data-w-id="65904593-024a-cf6a-a35d-cb3e8dbeb6a6" class="accordion-item---brix accordion-1---brix"><div class="accordion-trigger---brix"><div class="accordion-item-title---brix">How is World of Mouth Concierge different from other search engines and AI tools?</div><div class="accordion-arrow-wrap---brix"><div style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0)" class="accordion-arrow-wrapper---brix"><div class="arrow-line---brix _2---brix"></div><div class="arrow-line---brix _1---brix"></div></div></div></div><div style="height:0px;opacity:0" class="accordion-content---brix"><p class="accordion-paragraph---brix">Most search engines and AI tools answer by scanning the whole internet averaging reviews, following popularity, and filling the gaps with details they sometimes invent. It&#x27;s hard to know where an answer came from, or whether anyone stands behind it. WoM Concierge is different. Every place it suggests traces back to a real person who recommended it by name, a chef, a sommelier, a writer, a genuine restaurant lover. It draws first on our community, not on the loudest voices online. And it won&#x27;t pretend to know when it doesn&#x27;t have a good answer, it tells you it instead of inventing one to sound helpful.</p></div></div><div data-w-id="65904593-024a-cf6a-a35d-cb3e8dbeb6b1" class="accordion-item---brix accordion-1---brix"><div class="accordion-trigger---brix"><div class="accordion-item-title---brix">Who are the World of Mouth experts?</div><div class="accordion-arrow-wrap---brix"><div style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0)" class="accordion-arrow-wrapper---brix"><div class="arrow-line---brix _2---brix"></div><div class="arrow-line---brix _1---brix"></div></div></div></div><div style="height:0px;opacity:0" class="accordion-content---brix"><p class="accordion-paragraph---brix">World of Mouth Experts are handpicked restaurant industry insiders – chefs, restaurateurs, sommeliers and food writers – who understand quality across categories, from fine dining to street food.<br/><br/>We have a global community of over 800 carefully selected Experts. Experts are not allowed to recommend their own restaurants. We are transparent about where they work – and almost without exception, they are places our community recommends. <br/>‍<br/>‍<a href="/experts">Meet some of our Experts</a>.</p></div></div><div data-w-id="65904593-024a-cf6a-a35d-cb3e8dbeb6c6" class="accordion-item---brix accordion-1---brix"><div class="accordion-trigger---brix"><div class="accordion-item-title---brix">Who are the World of Mouth Members?</div><div class="accordion-arrow-wrap---brix"><div style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0)" class="accordion-arrow-wrapper---brix"><div class="arrow-line---brix _2---brix"></div><div class="arrow-line---brix _1---brix"></div></div></div></div><div style="height:0px;opacity:0" class="accordion-content---brix"><p class="accordion-paragraph---brix">Members are the people who make the community what it is, they are restaurant lovers from everywhere, joined by one thing: they care where they eat. They are not critics or reviewers. They are the friends you wish you had in every city. Many recommend places they love. All of them believe a good restaurant deserves to be found. In the app, Experts have a blue fork icon, Members have a diamond icon.</p></div></div><div data-w-id="65904593-024a-cf6a-a35d-cb3e8dbeb6d1" class="accordion-item---brix accordion-1---brix"><div class="accordion-trigger---brix"><div class="accordion-item-title---brix">Why should I pay?</div><div class="accordion-arrow-wrap---brix"><div style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(90deg) skew(0, 0)" class="accordion-arrow-wrapper---brix"><div class="arrow-line---brix _2---brix"></div><div class="arrow-line---brix _1---brix"></div></div></div></div><div style="height:0px;opacity:0" class="accordion-content---brix"><p class="accordion-paragraph---brix">Our mission is simple: give visibility to the places that deserve to be seen, not the ones that pay for the visibility. We are committed to three things. No ads. No sponsored lists. Free for every restaurant. The membership fee makes that possible and keeps us independent. And it is less than one disappointing meal.</p></div></div></div></div></div></div></div><div class="section_final_cta"><div class="padding-global"><div class="container-large background-color-beige corner-radius-20"><div class="padding-section-medium"><div class="inner-horizontal-paddings"><div class="centered gap-small"><div class="div-block-86"><div class="world-of-mouth-logo-wrapper w-dyn-list"><div role="list" class="hero-image-list w-dyn-items"><div role="listitem" class="hero-image w-dyn-item"><a href="https://worldofmouth.app/download" target="_blank" class="w-inline-block"><img loading="lazy" alt="World of Mouth app icon." src="https://cdn.prod.website-files.com/619776e2e737e7a8e46f94af/655e17d5be45f05c2b46f558_world-of-mouth-app.avif"/></a></div></div></div></div><h2 class="heading-display">Get the App</h2><div class="max-width-wrapper _500"><div class="margin-bottom"><p>Join the global restaurant-lovers community and start discovering curated recommendations by culinary experts.</p></div></div><div class="button-wom-header w-embed"><a href="#" target="_blank" class="website-button" id="openModalButton">
  <aside class="link-button-aside openGetTheAppModal">
    <div class="icon-restaurant-button w-embed hide-mobile-landscape">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_267_30127)">
          <path d="M15.3372 2.66602C15.3372 1.56145 14.4418 0.666016 13.3372 0.666016H10.6706C10.3024 0.666016 10.0039 0.964496 10.0039 1.33268C10.0039 1.70087 10.3024 1.99935 10.6706 1.99935H13.3372C13.7054 1.99935 14.0039 2.29783 14.0039 2.66602V5.33268C14.0039 5.70087 14.3024 5.99935 14.6706 5.99935C15.0388 5.99935 15.3372 5.70087 15.3372 5.33268V2.66602Z" fill="white" />
          <path d="M15.3372 10.6647C15.3372 10.2965 15.0388 9.99805 14.6706 9.99805C14.3024 9.99805 14.0039 10.2965 14.0039 10.6647V13.3314C14.0039 13.6996 13.7054 13.998 13.3372 13.998H10.6706C10.3024 13.998 10.0039 14.2965 10.0039 14.6647C10.0039 15.0329 10.3024 15.3314 10.6706 15.3314H13.3372C14.4418 15.3314 15.3372 14.436 15.3372 13.3314V10.6647Z" fill="white" />
          <path d="M2.66797 13.998C2.29978 13.998 2.0013 13.6996 2.0013 13.3314V10.6647C2.0013 10.2965 1.70282 9.99805 1.33464 9.99805C0.966449 9.99805 0.667969 10.2965 0.667969 10.6647V13.3314C0.667969 14.436 1.5634 15.3314 2.66797 15.3314H5.33464C5.70282 15.3314 6.0013 15.0329 6.0013 14.6647C6.0013 14.2965 5.70282 13.998 5.33464 13.998H2.66797Z" fill="white" />
