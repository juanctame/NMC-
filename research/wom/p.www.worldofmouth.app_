    const cl = (v, a, b) => Math.min(b, Math.max(a, v)),
      sm = (a, b, x) => {
        x = cl((x - a) / (b - a), 0, 1);
        return x * x * (3 - 2 * x);
      },
      lerp = (a, b, t) => a + (b - a) * t;
    const mixc = (a, b, t) => `rgb(${lerp(a[0], b[0], t) | 0},${lerp(a[1], b[1], t) | 0},${lerp(a[2], b[2], t) | 0})`;
    const load = (s) =>
